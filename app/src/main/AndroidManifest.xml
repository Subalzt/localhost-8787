<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Lets the laptop helper find the phone by broadcast, even with the screen off. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- The direct link: an offline hotspot the app starts itself, and joining another
         phone's. Android 13+ asks for nearby Wi-Fi devices (never used for location);
         older versions only allow it with location. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <!-- Where your phones and laptops are (server/Where.kt), precisely and all the time. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- See the long comment on <service> below for why specialUse and not dataSync. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Declared as a fallback so a build switched to dataSync still starts. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- The Music tab's player keeps playing with the app in the background (MusicService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- API 33+. Requested at runtime; the persistent notification is the only way to
         see the address, and where connection requests arrive. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Calls between linked phones (server/Calls.kt): the microphone, the call registered with
         Android as the app's own (Core-Telecom), its foreground service, and ringing full screen. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <!-- Video calls between linked phones. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Sharing the phone's screen in a call. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Music streaming reads the audio library only. READ_MEDIA_AUDIO covers audio and
         nothing else on Android 13+; older versions need the broader storage read. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- New screenshots go to the shared clipboard (Settings, Laptop access). Not needed when
         "All files access" is on, which covers the photo library too. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- What you copy in any app goes to the laptop with Localhost 8787 in the background (ClipWatch):
         the system log says when a copy happens, and a blink-long window over other apps reads
         it. READ_LOGS is granted once over USB with adb; the overlay in Android's settings. -->
    <uses-permission android:name="android.permission.READ_LOGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- The page shows each notification's app by name and icon. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Browsing the phone's storage from the laptop page (read-only). Android 11+ grants it
         only through its own "All files access" screen, which the owner opens from Settings.
         A sideloaded build; Play restricts this permission to file managers. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Sideloaded / personal build. Google Play restricts this permission to apps whose
         core function genuinely breaks under Doze, which this one does: an idle HTTP
         listener gets its sockets torn down. If this app is ever shipped through Play,
         drop this and route users through Settings.ACTION_IGNORE_BATTERY_OPTIMIZATION_SETTINGS
         instead, which OemBatterySetup already falls back to. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <!-- The app is useless without a network, but it must install on tablets and
         Wi-Fi-only devices, so nothing here is required="true". -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".BridgeApp"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.PhoneBridge">

        <!-- Security cameras (server/Cameras.kt): the control centre, over the lock screen too; the
             moment's wake that lets a locked phone start its camera; camera mode itself. -->
        <activity
            android:name=".ui.CamerasActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:launchMode="singleTask"
            android:taskAffinity="dev.periy.bridge.cameras"
            android:excludeFromRecents="false"
            android:theme="@style/Theme.PhoneBridge" />
        <activity
            android:name=".ui.CamWakeActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:taskAffinity="dev.periy.bridge.camwake"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PhoneBridge" />
        <service
            android:name=".service.CameraService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shown only for a moment when the camera cannot be started from the background, before handing over to the camera type." />
        </service>
        <service
            android:name=".ui.CamTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="Cameras"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Lost mode, over the lock screen (server/FindMe.kt). -->
        <activity
            android:name=".ui.LostActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PhoneBridge" />
        <receiver android:name=".server.FindMe$Stop" android:exported="false" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.PhoneBridge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Share-sheet targets. This is the primary way content leaves the phone:
              share from Gallery, Files, a browser, anywhere. Text lands in the
              clipboard slot; files are copied into the destination folder, because
              a share grant dies with the task and could not be served later.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Sends the phone's latest copy to the laptop: invisible, because Android lets an
             app read the clipboard only while it has the screen. Opened by the tile below. -->
        <activity
            android:name=".ui.ClipSendActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- The phone's notifications on the laptop page, answerable from there. Runs once
             "Notification access" is allowed for Localhost 8787, whether Localhost 8787 is open or not. -->
        <service
            android:name=".server.NotifyListener"
            android:exported="true"
            android:label="Localhost 8787: notifications on the laptop"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- This phone as a second screen for the laptop: the stream from the helper, full screen.
             Turning the phone must not restart it, or the stream would drop. -->
        <activity
            android:name=".ui.SecondScreenActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:label="Second screen"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- "Send to laptop" in the menu that appears on selecting text in any app: the words
             go on the shared clipboard at once, without opening Localhost 8787. -->
        <activity
            android:name=".ui.ClipTextActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:label="Send to laptop"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- "Copy to laptop" in the share sheet: a picture, file or text onto the shared clipboard
             (and the laptop's), unseen; "Localhost 8787" beside it still sends a file to save. -->
        <activity
            android:name=".ui.ClipShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:label="Copy to laptop"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".ui.ClipTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="Send clipboard"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
          foregroundServiceType: specialUse, deliberately, not dataSync.

          The prompt asked for dataSync with a note about the cap. Here is the note, and
          the reason I went the other way.

          Android 15 (API 35) applies a cumulative 6-hour-per-24h budget to dataSync
          foreground services. When it runs out the system calls Service.onTimeout() and
          the service must stop within seconds or be killed as an ANR. The usual reading
          is "a 10 GB upload takes ~90 minutes, so that is four transfers a day" — but
          that reading is wrong for this app, and the error is not conservative.

          The budget is charged against WALL-CLOCK TIME THE SERVICE IS RUNNING, not
          bytes moved. This app is a server. Its whole value is being reachable when the
          PC decides to open the page, which means the service is up and idle almost all
          of the time. A bridge left switched on after breakfast is dead by lunch, having
          transferred nothing at all. The cap is not a ceiling on transfers, it is a
          ceiling on uptime, and uptime is the product.

          specialUse has no timeout. This app also does not honestly fit any other type:
          it is not syncing to a remote account (dataSync), not playing media, not
          tracking location. It is a user-initiated local network service, which is
          exactly the residual case specialUse exists for.

          The cost is Google Play: specialUse requires a written justification at
          submission and review can reject it. That is not a constraint on a sideloaded
          personal build. If this ever needs to go through Play review, flip
          Fgs.TYPE in service/BridgeService.kt to dataSync and accept the 6h budget.
          onTimeout() is already implemented and shuts down cleanly rather than ANR-ing.
        -->
        <service
            android:name=".service.BridgeService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse|location"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Localhost 8787 hosts a local HTTP server on this device so a computer on the same network can transfer files and clipboard text to and from the phone. The service must remain running while the browser page is open, because the phone is the server." />
        </service>

        <!-- Music playing on the phone from the Music tab: the notification, the lock screen and a
             headset's buttons, with the app in the background. Only while there is a queue. -->
        <service
            android:name=".service.CallService"
            android:exported="false"
            android:foregroundServiceType="microphone|phoneCall|camera|mediaProjection" />
        <receiver
            android:name=".service.CallActions"
            android:exported="false" />

        <service
            android:name=".music.MusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Hands the picture or file on the shared clipboard to other apps that paste it.
             Only the clipboard folder, read-only (see res/xml/clip_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.clip"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/clip_paths" />
        </provider>
    </application>
</manifest>
